<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>IEEE Numeric Compact</title>
    <id>https://example.invalid/styles/ieee-numeric-compact</id>
    <link href="https://example.invalid/styles/ieee-numeric-compact" rel="self"/>
    <updated>2026-11-16T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
      <et-al font-style="normal"/>
    </names>
  </macro>
  <macro name="title">
    <text variable="title" quotes="true"/>
  </macro>
  <macro name="container">
    <choose>
      <if type="article-journal">
        <text variable="container-title" font-style="italic"/>
      </if>
      <else-if type="paper-conference chapter paper">
        <text term="in" suffix=": "/>
        <text variable="container-title" font-style="italic"/>
      </else-if>
      <else>
        <text variable="container-title" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="locator">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <label variable="issue" form="short"/>
        <text variable="issue"/>
      </group>
      <group delimiter=" ">
        <label variable="page" form="short" plural="contextual"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <macro name="date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="link">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi: "/>
      </if>
      <else-if variable="URL">
        <text variable="URL" prefix="[Online]. Available: "/>
      </else-if>
    </choose>
  </macro>
  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography et-al-min="7" et-al-use-first="6" hanging-indent="true" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] " />
      <text macro="author" suffix=", "/>
      <text macro="title" suffix=", "/>
      <text macro="container" suffix=", "/>
      <text macro="locator" suffix=", "/>
      <text macro="date" suffix=", "/>
      <text macro="link"/>
    </layout>
  </bibliography>
</style>
