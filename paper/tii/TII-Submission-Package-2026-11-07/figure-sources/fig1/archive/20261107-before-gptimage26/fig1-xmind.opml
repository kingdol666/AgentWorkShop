<opml version="2.0"><head><title>Fig. 1 — Cast-film control and observation paths</title></head><body><outline text="Fig. 1 — Cast-film control and observation paths"><outline text="Production context"><outline text="Cast-film line" /><outline text="Line-speed setpoint and film-thickness measurement are distinct nodes" /><outline text="Both mappings can use MQTT" /></outline><outline text="Control path"><outline text="Line-speed setpoint command" /><outline text="Command outcome" /><outline text="Optional setpoint readback (independent result)" /></outline><outline text="Observation path"><outline text="Separate film-thickness measurement node" /><outline text="Later process observation" /><outline text="Measurement node feeds process observation, not command readback" /><outline text="Illustrative association, not established causation" /></outline></outline></body></opml>
