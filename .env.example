# ============================================================
# 环境变量（可选）—— 覆盖层级：config.yml < data/runtime-settings.json < 环境变量 < CLI 参数
# 「运行配置」的单一事实来源是根目录 config.yml + data/runtime-settings.json(运行时覆盖)。
# 使用方式:复制本文件为 .env(gitignored)并按需填值;
# 启动器(start.mjs / dev-guard / aw CLI)会在启动前加载 .env,已导出的真实环境变量优先。
# ============================================================

# —— 生产必填:Session cookie 加密密钥(nuxt-auth-utils;≥32 位强随机)——
# 不配置(或仍是 config.yml 仓库默认值)时 production 将拒绝启动(security 插件)。
# 生成强随机值:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# NUXT_SESSION_PASSWORD=

# 运行模式（仅展示用途，实际 dev/prod 由命令决定）
# NUXT_PUBLIC_MODE=dev

# —— 端口/主机:先 env、再 runtime-settings、后 config.yml ——
# 开发端口(等价 `aw config set server.dev.port N`):PORT 或 NITRO_PORT 或 AW_SERVER_DEV_PORT
# 生产端口(等价 `aw config set server.prod.port N`):PORT 或 NITRO_PORT 或 AW_SERVER_PROD_PORT
# 监听地址: HOST / NITRO_HOST / AW_SERVER_HOST

# 通用:任意设置键都可经 AW_ 前缀 + 点转下划线覆盖(见 shared/config/schema.json)
#   AW_APP_TITLE=MyTitle
#   AW_THEME_PRIMARY_COLOR=#35e0a0
#   AW_THEME_MODE=dark
#   AW_API_TIMEOUT=15000
#   AW_SECURITY_APPROVAL_GATE=true

# —— 运行语义组(全部已配置化:config.yml 同名键为回退,历史 env 名兼容)——
# 记忆系统:
#   AW_MEMORY_PRIMER_TOKENS=300      # memory.primer_tokens
#   AW_MEMORY_INJECT_TOTAL=500       # memory.inject_total
#   AW_MEMORY_MAINTENANCE_MS=21600000
#   AW_MEMORY_EXPIRE_DAYS=180
#   AW_MEMORY_EXPIRE_SESSION_DAYS=14
#   AW_MEMORY_CAP=500
#   AW_MEMORY_REFLECT_TRIGGER=8
#   AW_MEMORY_EMBED_BASE_URL=        # OpenAI 兼容 /embeddings 基址(空=纯 FTS 检索)
#   AW_MEMORY_EMBED_MODEL=
#   AW_MEMORY_EMBED_API_KEY=
# omp Agent Harness:
#   AW_OMP_COMPACT_ENABLED=1         # =0 显式关闭自动压缩
#   AW_OMP_COMPACT_THRESHOLD=0.7
#   AW_OMP_COMPACT_MIN_INTERVAL_MS=300000
#   AW_OMP_COMPACT_WAIT_MS=120000
# 数控写控(回退闭环):
#   DCW_ROLLBACK_COOLDOWN_MS=300000
#   DCW_ROLLBACK_MIN_WINDOW_MS=120000
#   DCW_ROLLBACK_BASELINE_MS=600000
#   DCW_ROLLBACK_STALE_MS=1800000
# 车间运行 / 备份 / 保留 / 日志 / HITL:
#   WORKSHOP_IDLE_SWEEP_MS=30000
#   WORKSHOP_IDLE_GRACE_MS=120000
#   BACKUP_DISABLED=0  BACKUP_INTERVAL_HOURS=24  BACKUP_KEEP=7
#   RETENTION_DISABLED=1           # 整体关闭保留清理(调试)
#   AW_EVENTS_RETENTION_D=7
#   AWSHOP_LOG_LEVEL=info          # debug|info|warn|error
#   HITL_TIMEOUT_MS=180000
# 数采(部分键历史名无 AW_ 前缀,已作为别名兼容):
#   DAQ_MQTT_QOS=0  DAQ_MQTT_USERNAME=  DAQ_MQTT_PASSWORD=  DAQ_MQTT_CA_FILE=
#   DAQ_MQTT_REJECT_UNAUTHORIZED=0
#   DAQ_TS_RETENTION_H=168  DAQ_FRAME_RETENTION_H=720
#   ALARM_WEBHOOK_URL=  ALARM_ESCALATE_MINUTES=15
#   DAQ_TSDB_URL / DAQ_OS_URL / DAQ_MQTT_URL   # 整串 URL 覆盖(最高优先,由 config 连接参数拼装兜底)

# —— AW Home(全局安装/任意目录运行时的配置中枢;repo 检出内运行则用检出内配置)——
# AW_HOME=D:\aw-home        # 重定向用户主目录中枢(默认 ~/.AgentWorkShop)
# AW_MODE=home              # 强制 home 模式(启动器内部使用)

# 后端 API 基址
# NUXT_PUBLIC_API_BASE=/api
