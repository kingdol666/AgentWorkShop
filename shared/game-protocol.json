{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "title": "Tuxemon Town Agent-UI 渲染协议",
  "description": "后端 Agent 通过 WebSocket 下发渲染指令驱动前端 Phaser 场景;前端将渲染事实与玩家输入上行回传。本文件是前后端交互的单一事实来源:前端执行、后端决策、Agent 动作词表均由本注册表约束。后续 MCP 集成时,agentCallable=true 的 downlink 指令即 Agent 可调用的工具集合。",

  "envelope": {
    "description": "线上消息信封:所有消息均为此结构",
    "schema": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "指令/事件名,见 downlink/uplink 注册表键" },
        "payload": { "type": "object", "description": "参数载荷,由对应指令的 inputSchema 约束" }
      },
      "required": ["type", "payload"],
      "additionalProperties": false
    }
  },

  "downlink": {
    "session.ready": {
      "agentCallable": false,
      "description": "连接确认:告知前端 Agent 身份与出生点,前端据此放置 Agent 精灵并开始渲染。连接建立或重连时由会话层自动下发。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentName": { "type": "string", "description": "Agent 名称,用于对话框标题与 HUD 展示" },
          "spawn": {
            "type": "object",
            "description": "Agent 出生点像素坐标(地图 40x40 tiles,每 tile 32px)",
            "properties": {
              "x": { "type": "number", "description": "像素 X 坐标" },
              "y": { "type": "number", "description": "像素 Y 坐标" }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          }
        },
        "required": ["agentName", "spawn"],
        "additionalProperties": false
      },
      "example": { "type": "session.ready", "payload": { "agentName": "script-demo", "spawn": { "x": 720, "y": 656 } } }
    },
    "agent.state": {
      "agentCallable": true,
      "description": "声明 Agent 行为模式与移动速度。mode 决定 HUD 徽标与行为状态机展示(idle 待机/wander 游荡/approach 靠近/talk 对话/wait 等待);speed 为后续 agent.move 指令的实际移动速度(px/s)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["idle", "wander", "approach", "talk", "wait"], "description": "行为模式" },
          "speed": { "type": "number", "minimum": 0, "description": "移动速度 px/s" }
        },
        "required": ["mode", "speed"],
        "additionalProperties": false
      },
      "example": { "type": "agent.state", "payload": { "mode": "wander", "speed": 120 } }
    },
    "agent.move": {
      "agentCallable": true,
      "description": "让 Agent 精灵沿 dir 方向移动 durationMs 毫秒。移动由前端物理执行,受地图碰撞约束,撞墙时提前停止;会话层对同向且未到期的重复指令做合并。Agent 可通过 agent.pos 上行获知实际渲染位置。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dir": { "type": "string", "enum": ["up", "down", "left", "right"], "description": "移动方向" },
          "durationMs": { "type": "number", "minimum": 0, "description": "移动持续毫秒数" }
        },
        "required": ["dir", "durationMs"],
        "additionalProperties": false
      },
      "example": { "type": "agent.move", "payload": { "dir": "right", "durationMs": 500 } }
    },
    "agent.face": {
      "agentCallable": true,
      "description": "改变 Agent 朝向(不移动)。用于面向玩家、面向交互目标;会话层对重复朝向做合并。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dir": { "type": "string", "enum": ["up", "down", "left", "right"], "description": "朝向" }
        },
        "required": ["dir"],
        "additionalProperties": false
      },
      "example": { "type": "agent.face", "payload": { "dir": "down" } }
    },
    "agent.say": {
      "agentCallable": true,
      "description": "在 Agent 头顶显示气泡文字,ttlMs 毫秒后淡出。用于闲聊、提示、响应玩家。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "气泡文字内容" },
          "ttlMs": { "type": "number", "minimum": 0, "description": "气泡展示时长(毫秒)" }
        },
        "required": ["text", "ttlMs"],
        "additionalProperties": false
      },
      "example": { "type": "agent.say", "payload": { "text": "你好呀!", "ttlMs": 2200 } }
    },
    "dialog.open": {
      "agentCallable": true,
      "description": "打开对话面板,按 lines 顺序逐句展示。玩家按空格/回车逐句推进,推进到末句后由会话层下发 dialog.close。对话期间玩家移动被前端锁定。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentName": { "type": "string", "description": "对话发起者名称(面板标题)" },
          "lines": {
            "type": "array",
            "description": "对话台词,逐句展示",
            "items": { "type": "string" }
          }
        },
        "required": ["agentName", "lines"],
        "additionalProperties": false
      },
      "example": { "type": "dialog.open", "payload": { "agentName": "script-demo", "lines": ["你好呀,我是图克斯镇的精灵向导!"] } }
    },
    "dialog.advance": {
      "agentCallable": false,
      "description": "对话推进到下一句。由玩家 input.interact 上行触发,会话层权威下发;前端执行打字机动画切换。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "example": { "type": "dialog.advance", "payload": {} }
    },
    "dialog.close": {
      "agentCallable": true,
      "description": "关闭对话面板并恢复玩家移动。玩家推进到末句或 Agent 主动调用本指令时由会话层下发;大脑会收到 brainEvents.dialog.closed 事件。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "example": { "type": "dialog.close", "payload": {} }
    },
    "error": {
      "agentCallable": false,
      "description": "错误通知:code 为错误码,message 为人类可读信息。前端在 HUD/控制台提示,不上报交互。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "错误码(如 BAD_MESSAGE/UNKNOWN_COMMAND/INVALID_PAYLOAD)" },
          "message": { "type": "string", "description": "错误描述" }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "example": { "type": "error", "payload": { "code": "BAD_MESSAGE", "message": "无法解析的消息" } }
    }
  },

  "uplink": {
    "session.join": {
      "description": "客户端连接注册。连接建立或断线重连时前端主动发送;会话层据此重置对话状态并回发 session.ready。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentId": { "type": "string", "description": "预留:多 Agent 场景的 Agent 选择标识" }
        },
        "additionalProperties": false
      },
      "example": { "type": "session.join", "payload": {} }
    },
    "input.move": {
      "description": "玩家移动方向变化上报(轴向量 -1/0/1),仅在状态变化时发送。供后端感知玩家意图(本轮不控制玩家)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dx": { "type": "number", "enum": [0, 1, -1], "description": "X 轴方向:1 右,-1 左" },
          "dy": { "type": "number", "enum": [0, 1, -1], "description": "Y 轴方向:1 下,-1 上" }
        },
        "required": ["dx", "dy"],
        "additionalProperties": false
      },
      "example": { "type": "input.move", "payload": { "dx": 1, "dy": 0 } }
    },
    "input.interact": {
      "description": "玩家交互请求(空格/回车),用于对话推进;会话层权威决定对话推进/关闭。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "example": { "type": "input.interact", "payload": {} }
    },
    "player.pos": {
      "description": "玩家位置快照(像素 + tile 坐标),前端 250ms 节流上报。是 Agent 感知世界的主要来源:大脑据此计算距离并决策 approach/talk 等行为。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": { "type": "number", "description": "像素 X 坐标" },
          "y": { "type": "number", "description": "像素 Y 坐标" },
          "tileX": { "type": "number", "description": "tile X 坐标" },
          "tileY": { "type": "number", "description": "tile Y 坐标" }
        },
        "required": ["x", "y", "tileX", "tileY"],
        "additionalProperties": false
      },
      "example": { "type": "player.pos", "payload": { "x": 470, "y": 830, "tileX": 14, "tileY": 25 } }
    },
    "agent.pos": {
      "description": "Agent 渲染位置事实上报(像素),前端 250ms 节流上报。移动的物理碰撞在客户端,位置真相在渲染层;服务端大脑据此计算与玩家的真实距离。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": { "type": "number", "description": "像素 X 坐标" },
          "y": { "type": "number", "description": "像素 Y 坐标" }
        },
        "required": ["x", "y"],
        "additionalProperties": false
      },
      "example": { "type": "agent.pos", "payload": { "x": 720, "y": 656 } }
    }
  },

  "agentContext": {
    "description": "Agent 每个决策 tick 看到的世界快照,由会话层装配后传入 brain.think(ctx)。player.distance 为 Agent 到玩家像素距离(未见玩家时为 Infinity)。注意:rng 为不可序列化的随机函数,仅存在于进程内接口。",
    "schema": {
      "type": "object",
      "properties": {
        "tick": { "type": "number", "description": "决策序号,自会话启动递增" },
        "now": { "type": "number", "description": "世界时钟(epoch ms),Agent 据此推算动作结束时刻" },
        "agent": {
          "type": "object",
          "description": "Agent 自身状态快照(位置来自前端 agent.pos 事实上报)",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "dir": { "type": "string", "enum": ["up", "down", "left", "right"] },
            "mode": { "type": "string", "enum": ["idle", "wander", "approach", "talk", "wait"] }
          },
          "required": ["x", "y", "dir", "mode"],
          "additionalProperties": false
        },
        "player": {
          "type": "object",
          "description": "玩家感知快照",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "lastSeenAt": { "type": "number", "description": "最近一次收到 player.pos 的时间(epoch ms);从未上报时为 null" },
            "distance": { "type": "number", "description": "Agent 到玩家像素距离;未见玩家时为 Infinity" }
          },
          "required": ["x", "y", "lastSeenAt", "distance"],
          "additionalProperties": false
        }
      },
      "required": ["tick", "now", "agent", "player"],
      "additionalProperties": false
    }
  },

  "brainEvents": {
    "dialog.closed": {
      "description": "对话关闭事件:玩家推进到末句、断线重连或 Agent 主动 dialog.close 时,会话层通知大脑进行状态迁移(如转入冷却/恢复游荡)。"
    }
  }
}
