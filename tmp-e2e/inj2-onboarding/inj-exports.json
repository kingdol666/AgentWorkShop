{
 "inj-machine-mbtcp": {
  "device": {
   "id": "inj-machine-mbtcp",
   "name": "注塑主机PLC(Modbus TCP)",
   "description": "注塑机主机:机筒四区加热 + 螺杆塑化传动。塑化段,决定熔体温度与计量精度。",
   "protocol": "modbus-tcp"
  },
  "items": [
   {
    "signal": "机筒温度区1SP",
    "driver": "modbus-tcp",
    "description": "进料段机筒温度(水冷进料口防架桥),四区最低",
    "unit": "℃",
    "min": 160,
    "max": 300,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40021,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40021,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "机筒温度区2SP",
    "driver": "modbus-tcp",
    "description": "压缩段机筒温度,物料开始熔融",
    "unit": "℃",
    "min": 160,
    "max": 300,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40023,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40023,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "机筒温度区3SP",
    "driver": "modbus-tcp",
    "description": "计量段中段机筒温度",
    "unit": "℃",
    "min": 160,
    "max": 300,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40025,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40025,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "机筒温度区4SP",
    "driver": "modbus-tcp",
    "description": "喷嘴段机筒温度,四区最高;与熔体温度强相关",
    "unit": "℃",
    "min": 160,
    "max": 300,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40027,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40027,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "螺杆转速SP",
    "driver": "modbus-tcp",
    "description": "塑化螺杆转速(rpm);剪切热叠加进熔体温度(约 +0.11℃/rpm)",
    "unit": "rpm",
    "min": 60,
    "max": 200,
    "decimals": 0,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40029,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40029,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "MeltTemp",
    "driver": "modbus-tcp",
    "description": "喷嘴前熔体实测温度(采集);工艺窗 235~262℃,超窗劣化飞边/缩痕",
    "unit": "℃",
    "min": 20,
    "max": 320,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40001,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40001,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "MeltPress",
    "driver": "modbus-tcp",
    "description": "塑化背压(采集,bar)",
    "unit": "bar",
    "min": 0,
    "max": 160,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 16052,
     "unitId": 1,
     "register": 40003,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-tcp\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":16052,\"unitId\":1,\"register\":40003,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   }
  ]
 },
 "inj-mold-rtu": {
  "device": {
   "id": "inj-mold-rtu",
   "name": "模温机与锁模单元(Modbus RTU)",
   "description": "模温控制机 + 锁模单元。模具温度决定表面复制/缩痕/飞边阈值,锁模力是飞边的物理上限。",
   "protocol": "modbus-rtu"
  },
  "items": [
   {
    "signal": "模具温度SP",
    "driver": "modbus-rtu",
    "description": "模温机设定(℃);过低→缩痕/表面无光,过高→飞边与节拍变长",
    "unit": "℃",
    "min": 20,
    "max": 95,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 15052,
     "unitId": 1,
     "register": 40021,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-rtu\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":15052,\"unitId\":1,\"register\":40021,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "锁模力SP",
    "driver": "modbus-rtu",
    "description": "锁模力设定(kN);保压+注射压力的飞边阈值由此决定",
    "unit": "kN",
    "min": 800,
    "max": 2500,
    "decimals": 0,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 15052,
     "unitId": 1,
     "register": 40023,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-rtu\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":15052,\"unitId\":1,\"register\":40023,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "MoldTempPV",
    "driver": "modbus-rtu",
    "description": "模具实测温度(采集)",
    "unit": "℃",
    "min": 10,
    "max": 110,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 15052,
     "unitId": 1,
     "register": 40001,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-rtu\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":15052,\"unitId\":1,\"register\":40001,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   },
   {
    "signal": "ClampPV",
    "driver": "modbus-rtu",
    "description": "锁模力实测(采集)",
    "unit": "kN",
    "min": 0,
    "max": 2600,
    "decimals": 0,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 15052,
     "unitId": 1,
     "register": 40003,
     "registerType": "holding",
     "dataType": "float32",
     "byteOrder": "big"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"modbus-rtu\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":15052,\"unitId\":1,\"register\":40003,\"registerType\":\"holding\",\"dataType\":\"float32\",\"byteOrder\":\"big\"}}'"
   }
  ]
