    "min": 0,
    "max": 10,
    "decimals": 3,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/sink",
     "jsonPath": "value"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/sink\",\"jsonPath\":\"value\"}}'"
   },
   {
    "signal": "DimDev",
    "driver": "http",
    "description": "关键尺寸偏差(采集,mm);规格 ±0.05 mm",
    "unit": "mm",
    "min": -0.5,
    "max": 0.5,
    "decimals": 3,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/dim",
     "jsonPath": "value"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/dim\",\"jsonPath\":\"value\"}}'"
   },
   {
    "signal": "CycleTime",
    "driver": "http",
    "description": "生产节拍(采集,s/模)——质量与产能的权衡记录量",
    "unit": "s",
    "min": 5,
    "max": 60,
    "decimals": 1,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/cycle",
     "jsonPath": "value"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/cycle\",\"jsonPath\":\"value\"}}'"
   },
   {
    "signal": "WallProfile",
    "driver": "http",
    "format": "vector",
    "description": "制品壁厚轮廓 48 点向量帧(采集,mm)",
    "unit": "mm",
    "min": 1,
    "max": 5,
    "decimals": 4,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/profile",
     "jsonPath": "points"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/profile\",\"jsonPath\":\"points\"}}'"
   },
   {
    "signal": "SurfaceImg",
    "driver": "http",
    "format": "image",
    "description": "制品外观灰度图像帧(采集;亮点 ∝ 飞边缺陷)",
    "unit": "灰度",
    "min": 0,
    "max": 255,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/ccd"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/ccd\"}}'"
   }
  ]
 }
}