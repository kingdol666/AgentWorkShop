 "inj-inject-opcua": {
  "device": {
   "id": "inj-inject-opcua",
   "name": "注射/保压单元(OPC UA)",
   "description": "注射与保压执行单元:注射速度、保压压力与保压时间是克重的第一控制组。",
   "protocol": "opcua"
  },
  "items": [
   {
    "signal": "InjectSpeedSP",
    "driver": "opcua",
    "description": "注射速度(mm/s);影响充模与注射压力,克重次要项",
    "unit": "mm/s",
    "min": 30,
    "max": 130,
    "decimals": 0,
    "driverConfig": {
     "endpoint": "opc.tcp://127.0.0.1:5843",
     "nodeId": "ns=2;s=Inj.Inj.Speed.Sp"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"opcua\",\"driverConfig\":{\"endpoint\":\"opc.tcp://127.0.0.1:5843\",\"nodeId\":\"ns=2;s=Inj.Inj.Speed.Sp\"}}'"
   },
   {
    "signal": "HoldPressSP",
    "driver": "opcua",
    "description": "保压压力(bar)——克重/缩痕/飞边的第一控制量;低了缩痕重、高了飞边出",
    "unit": "bar",
    "min": 20,
    "max": 110,
    "decimals": 1,
    "driverConfig": {
     "endpoint": "opc.tcp://127.0.0.1:5843",
     "nodeId": "ns=2;s=Inj.Hold.P.Sp"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"opcua\",\"driverConfig\":{\"endpoint\":\"opc.tcp://127.0.0.1:5843\",\"nodeId\":\"ns=2;s=Inj.Hold.P.Sp\"}}'"
   },
   {
    "signal": "HoldTimeSP",
    "driver": "opcua",
    "description": "保压时间(s);浇口冻结前持续补缩,与保压压力同向",
    "unit": "s",
    "min": 3,
    "max": 15,
    "decimals": 1,
    "driverConfig": {
     "endpoint": "opc.tcp://127.0.0.1:5843",
     "nodeId": "ns=2;s=Inj.Hold.T.Sp"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"opcua\",\"driverConfig\":{\"endpoint\":\"opc.tcp://127.0.0.1:5843\",\"nodeId\":\"ns=2;s=Inj.Hold.T.Sp\"}}'"
   },
   {
    "signal": "InjPressPV",
    "driver": "opcua",
    "description": "注射压力实测(采集,bar);超 95 bar 起飞边贡献",
    "unit": "bar",
    "min": 0,
    "max": 180,
    "decimals": 1,
    "driverConfig": {
     "endpoint": "opc.tcp://127.0.0.1:5843",
     "nodeId": "ns=2;s=Inj.Inj.P.Pv"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"opcua\",\"driverConfig\":{\"endpoint\":\"opc.tcp://127.0.0.1:5843\",\"nodeId\":\"ns=2;s=Inj.Inj.P.Pv\"}}'"
   }
  ]
 },
 "inj-cool-mqtt": {
  "device": {
   "id": "inj-cool-mqtt",
   "name": "冷却水单元(MQTT)",
   "description": "模温机冷却水回路:水温设定经 MQTT 命令主题下发;水温偏高顶高模具实际温度。",
   "protocol": "mqtt"
  },
  "items": [
   {
    "signal": "WaterTempPV",
    "driver": "mqtt",
    "description": "冷却水实测温度(采集,℃)",
    "unit": "℃",
    "min": 5,
    "max": 60,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 18830,
     "topic": "aw/inj/wtemp",
     "jsonPath": "data.temp"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"mqtt\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":18830,\"topic\":\"aw/inj/wtemp\",\"jsonPath\":\"data.temp\"}}'"
   },
   {
    "signal": "CoolFlowPV",
    "driver": "mqtt",
    "description": "冷却水流量(采集,L/min)",
    "unit": "L/min",
    "min": 0,
    "max": 80,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 18830,
     "topic": "aw/inj/flow",
     "jsonPath": "data.flow"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"mqtt\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":18830,\"topic\":\"aw/inj/flow\",\"jsonPath\":\"data.flow\"}}'"
   },
   {
    "signal": "CoolWaterSP",
    "driver": "mqtt",
    "description": "冷却水温设定(℃,MQTT 命令主题下发);>32℃ 开始顶高模具温度",
    "unit": "℃",
    "min": 10,
    "max": 45,
    "decimals": 1,
    "driverConfig": {
     "host": "127.0.0.1",
     "port": 18830,
     "topic": "aw/inj/coolwater/set",
     "jsonKey": "setpoint"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"mqtt\",\"driverConfig\":{\"host\":\"127.0.0.1\",\"port\":18830,\"topic\":\"aw/inj/coolwater/set\",\"jsonKey\":\"setpoint\"}}'"
   }
  ]
 },
 "inj-inspect-http": {
  "device": {
   "id": "inj-inspect-http",
   "name": "制品质量检测站(HTTP)",
   "description": "在线称重与外观检测站:克重/飞边/缩痕/尺寸/节拍 + 壁厚轮廓与外观图像帧。",
   "protocol": "http"
  },
  "items": [
   {
    "signal": "PartWeight",
    "driver": "http",
    "description": "制品克重(采集,g)——闭环寻优的被控量,规格 32.5±0.35 g",
    "unit": "g",
    "min": 25,
    "max": 40,
    "decimals": 2,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/weight",
     "jsonPath": "value"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/weight\",\"jsonPath\":\"value\"}}'"
   },
   {
    "signal": "FlashRate",
    "driver": "http",
    "description": "飞边率(采集,%);>0.4% 需退保压,模具损伤风险",
    "unit": "%",
    "min": 0,
    "max": 5,
    "decimals": 3,
    "driverConfig": {
     "url": "http://127.0.0.1:4010/sim-http/inj-inspect-http/api/flash",
     "jsonPath": "value"
    },
    "curl": "curl -s -X POST http://127.0.0.1:3021/api/workshop/daq/test-driver\\n  -H 'content-type: application/json'\\n  -d '{\"driver\":\"http\",\"driverConfig\":{\"url\":\"http://127.0.0.1:4010/sim-http/inj-inspect-http/api/flash\",\"jsonPath\":\"value\"}}'"
   },
   {
    "signal": "SinkMark",
    "driver": "http",
    "description": "缩痕指数(采集,%);>1.5% 外观不良,保压不足信号",
