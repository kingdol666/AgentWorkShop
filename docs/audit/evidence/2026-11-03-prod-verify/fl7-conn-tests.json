{
  "tests": [
    {
      "label": "PROTO4-FL7-SP-灌装背压(mqtt)",
      "driver": "mqtt",
      "driverConfig": {
        "host": "127.0.0.1",
        "port": 56830,
        "topic": "aw/twin/f7-backpressure/set",
        "jsonKey": "setpoint",
        "holdIntervalMs": 0,
        "readTopic": "aw/twin/f7-backpressure/bp-confirm-pv",
        "readJsonPath": "data.bp-confirm-pv"
      }
    },
    {
      "label": "PROTO4-FL7-SP-传送带速度(modbus-tcp)",
      "driver": "modbus-tcp",
      "driverConfig": {
        "host": "127.0.0.1",
        "port": 37686,
        "unitId": 2,
        "register": 40001,
        "registerType": "holding",
        "dataType": "float32",
        "byteOrder": "big",
        "holdIntervalMs": 0
      }
    },
